# Required for real AI insights. Without it the app runs in demo mode with rule-based tips.
ANTHROPIC_API_KEY=your_key_here

# Optional. Model used for insights (default: claude-sonnet-5-5, as in the deck's cost estimate).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional, recommended in production. Shared rate limit across server instances.
# Create a free database at https://upstash.com and copy the REST URL and token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
